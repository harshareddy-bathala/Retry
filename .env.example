# .env.example — Retry
# Copy to .env for local dev. Production values live in /etc/retry/*.env (never in the repo).
# Every variable is validated at boot by apps/api/src/lib/env.ts (Zod) — the app refuses to start on a missing/invalid value.

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

# ── Database (local docker compose; prod = DO Managed PG connection string)
DATABASE_URL=postgresql://retry:retry@localhost:5432/retry
# Managed PG basic tier is 1GB — keep the pool small
DATABASE_POOL_MAX=10

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Staging shares the instance with a different db index, e.g. redis://.../1

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-64-random-chars
JWT_SECRET_PREVIOUS=            # set during rotation, else empty
ACCESS_TOKEN_TTL=7d             # FR-AUTH-03
REFRESH_TOKEN_TTL=30d
ALLOWED_EMAIL_DOMAIN=nttf.co.in # FR-AUTH-01; e.g. tokennumber@nttf.co.in — '*' allows any domain (local dev ONLY)
SECRET_ENCRYPTION_KEY=          # 32-byte base64 — AES-256 for stored third-party tokens (NFR-SEC-03)

# ── Admin bootstrap (seed) ──────────────────────────────────────────────
ADMIN_EMAIL=admin@nttf.co.in
ADMIN_PASSWORD=change-me-on-first-login

# ── Anthropic (grading worker ONLY — Hard Rule 2) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
GRADING_JOB_TIMEOUT_MS=600000   # 10 min hard timeout (FR-GRADE-10)
GRADING_CONCURRENCY=2
SIMILARITY_FLAG_THRESHOLD=0.85  # FR-GRADE-09, admin-configurable at runtime; this is the default

# ── GitHub (repo clone for grading) ─────────────────────────────────────
GITHUB_TOKEN=ghp_...            # read-only
REPO_CLONE_DIR=/tmp/retry-clones
REPO_CLONE_MAX_MB=200

# ── LiveKit, self-hosted (goes in apps/room-server/.env — the secret must never
#    reach apps/api or the client. All three unset = AV off and placeholder
#    bubbles remain, which is a fully supported state) ────────────────────────
#
# FOR LOCAL DEV, use these three verbatim. `docker compose up -d` runs a real
# LiveKit server in dev mode, and these are its fixed credentials:
#
#   LIVEKIT_URL=ws://localhost:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
#
# Nothing about AV needs the VPS to be exercised. Provisioning it is a separate
# job (TLS, TURN on TCP/443, the 50000-60000 UDP range) — docs/livekit-vps.md.
LIVEKIT_URL=                    # dev: ws://localhost:7880 · prod: wss://livekit.<domain>
LIVEKIT_API_KEY=                # dev: devkey
LIVEKIT_API_SECRET=             # dev: secret
PROXIMITY_THRESHOLD_TILES=5     # FR-ROOM-28 default; admin-configurable at runtime

# ── Email (dev: Mailpit via docker compose; prod: college SMTP with TLS) ─
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Retry <retry@nttf.co.in>"

# ── Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads            # prod: /var/lib/retry/uploads
UPLOAD_MAX_MB=2

# ── Monitoring ──────────────────────────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_WEB=                 # consumed by Vite as VITE_SENTRY_DSN at build
NEW_RELIC_LICENSE_KEY=

# ── Room server (Retry Rooms multiplayer) ─────────────────────────────
ROOM_SERVER_PORT=4100           # shares JWT_SECRET with the API for WS auth
# VITE_ROOM_WS_URL=ws://localhost:4100/ws  # web override; this is the default

# Server-to-server channel: the API pushes membership changes into the live
# world (evict a removed member, refresh the Commons doors). Set the SAME value
# in apps/api/.env and apps/room-server/.env; min 16 chars. Unset on either side
# = /internal is not mounted and a removed member stays in the map until they
# walk out. Private network only — never expose /internal through Nginx.
INTERNAL_API_SECRET=
ROOM_SERVER_INTERNAL_URL=http://127.0.0.1:4100   # apps/api only

# ── tldraw ──────────────────────────────────────────────────────────────
# Sync is served by the room server at /whiteboard on ROOM_SERVER_PORT —
# there is no separate tldraw process.
# Unset → the editor renders tldraw's "get a license" watermark, which is the
# licensed way to run unlicensed. Set it (trial or paid key from tldraw.dev)
# and the watermark goes away. Never hide it any other way — the licence calls
# watermark display a technical measure.
VITE_TLDRAW_LICENSE_KEY=

# ── Dev conveniences ────────────────────────────────────────────────────
SEED_DEMO_DATA=true             # fake students/posts/fork-chain; never true in prod
FAKE_AI_GRADING=true            # worker returns canned grade instead of calling Anthropic

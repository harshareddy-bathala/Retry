# Dependencies
node_modules/
.pnpm-store/

# Env & secrets — .env.example is the only committed env file
.env
.env.*
!.env.example

# Builds
dist/
build/
*.tsbuildinfo
apps/web/dist/
apps/api/dist/

# Test & coverage
coverage/
playwright-report/
test-results/

# Licensed art (LimeZu "Modern Interiors", limezu.itch.io)
# Its licence permits using and editing the assets in a project, but NOT
# redistributing them. This repository is PRIVATE, so the pack is committed
# here — see docs/assets-setup.md. If this repository is ever made public
# again, `assets/` must be removed from history BEFORE that happens.
#
# `pnpm assets:build` output stays ignored: it is regenerable from the pack,
# and committing it would mean two copies of the same pixels in git.
packages/maps/generated/

# Local data
uploads/
*.local

# Logs
*.log
logs/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db


{
  "name": "@retry/maps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./studio_a.json": "./maps/studio_a.json",
    "./commons.json": "./maps/commons.json",
    "./tilesets/retry.png": "./tilesets/retry.png",
    "./avatars/*.png": "./avatars/*.png"
  },
  "scripts": {
    "validate": "tsx scripts/validate-maps.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test art",
    "test": "vitest run",
    "test:watch": "vitest",
    "art": "pnpm assets:build && tsx scripts/author-maps.ts && tsx scripts/validate-maps.ts",
    "assets:build": "tsx scripts/build-assets.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@retry/config": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}

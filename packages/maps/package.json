{
  "name": "@retry/maps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./studio_a.json": "./maps/studio_a.json",
    "./commons.json": "./maps/commons.json",
    "./classroom.json": "./maps/classroom.json",
    "./lounge.json": "./maps/lounge.json",
    "./conference.json": "./maps/conference.json",
    "./generated/tilesets": "./generated/tilesets.ts",
    "./generated/characters": "./generated/characters.ts",
    "./generated/animated": "./generated/animated.ts",
    "./generated/emotes": "./generated/emotes.ts",
    "./generated/manifest.json": "./generated/manifest.json"
  },
  "scripts": {
    "validate": "tsx scripts/validate-maps.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test art",
    "test": "vitest run",
    "test:watch": "vitest",
    "art": "pnpm assets:build && tsx scripts/validate-maps.ts",
    "assets:build": "tsx scripts/build-assets.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "tiled": "tsx scripts/build-tiled.ts",
    "preview": "tsx scripts/preview-map.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@retry/config": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
